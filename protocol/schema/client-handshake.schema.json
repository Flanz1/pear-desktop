{
  "$id": "https://github.com/Flanz1/pear-desktop/protocol/schema/client-handshake.schema.json",
  "title": "First message from the phone (protocol 1.0)",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "hello"
        },
        "protocol": {
          "type": "object",
          "properties": {
            "major": {
              "type": "integer",
              "minimum": 0,
              "maximum": 999
            },
            "minor": {
              "type": "integer",
              "minimum": 0,
              "maximum": 999
            }
          },
          "required": ["major", "minor"],
          "additionalProperties": false
        },
        "client": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^[a-z0-9-]{1,64}$"
            },
            "version": {
              "type": "string",
              "pattern": "^[0-9A-Za-z.+-]{1,32}$"
            }
          },
          "required": ["name", "version"],
          "additionalProperties": false
        },
        "deviceId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "token": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        }
      },
      "required": ["type", "protocol", "client", "deviceId", "token"],
      "additionalProperties": false
    },
    {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "pair.request"
            },
            "protocol": {
              "type": "object",
              "properties": {
                "major": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 999
                },
                "minor": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 999
                }
              },
              "required": ["major", "minor"],
              "additionalProperties": false
            },
            "client": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[a-z0-9-]{1,64}$"
                },
                "version": {
                  "type": "string",
                  "pattern": "^[0-9A-Za-z.+-]{1,32}$"
                }
              },
              "required": ["name", "version"],
              "additionalProperties": false
            },
            "device": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "model": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": ["name", "model"],
              "additionalProperties": false
            },
            "secret": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{22}$"
            }
          },
          "required": ["type", "protocol", "client", "device", "secret"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "pair.request"
            },
            "protocol": {
              "type": "object",
              "properties": {
                "major": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 999
                },
                "minor": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 999
                }
              },
              "required": ["major", "minor"],
              "additionalProperties": false
            },
            "client": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[a-z0-9-]{1,64}$"
                },
                "version": {
                  "type": "string",
                  "pattern": "^[0-9A-Za-z.+-]{1,32}$"
                }
              },
              "required": ["name", "version"],
              "additionalProperties": false
            },
            "device": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "model": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": ["name", "model"],
              "additionalProperties": false
            },
            "code": {
              "type": "string",
              "pattern": "^[0-9]{6}$"
            }
          },
          "required": ["type", "protocol", "client", "device", "code"],
          "additionalProperties": false
        }
      ]
    }
  ]
}
