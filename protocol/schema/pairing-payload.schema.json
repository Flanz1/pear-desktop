{
  "$id": "https://github.com/Flanz1/pear-desktop/protocol/schema/pairing-payload.schema.json",
  "title": "Decoded pairing QR payload (protocol 1.1)",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "majors": {
      "minItems": 1,
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 999
      }
    },
    "host": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[0-9A-Fa-f.:]+$"
    },
    "port": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 65535
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "secret": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{22}$"
    },
    "instanceId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "name": {
      "type": "string",
      "maxLength": 500
    }
  },
  "required": [
    "majors",
    "host",
    "port",
    "fingerprint",
    "secret",
    "instanceId",
    "name"
  ],
  "additionalProperties": false
}
