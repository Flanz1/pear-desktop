{
  "description": "Version negotiation. supported maps major -> highest minor the desktop implements.",
  "cases": [
    {
      "name": "same version",
      "client": {
        "major": 1,
        "minor": 0
      },
      "supported": {
        "1": 0
      },
      "expect": {
        "ok": true,
        "version": {
          "major": 1,
          "minor": 0
        }
      }
    },
    {
      "name": "newer client minor is capped",
      "client": {
        "major": 1,
        "minor": 4
      },
      "supported": {
        "1": 2
      },
      "expect": {
        "ok": true,
        "version": {
          "major": 1,
          "minor": 2
        }
      }
    },
    {
      "name": "older client minor kept",
      "client": {
        "major": 1,
        "minor": 1
      },
      "supported": {
        "1": 3
      },
      "expect": {
        "ok": true,
        "version": {
          "major": 1,
          "minor": 1
        }
      }
    },
    {
      "name": "previous major still supported",
      "client": {
        "major": 1,
        "minor": 5
      },
      "supported": {
        "1": 5,
        "2": 0
      },
      "expect": {
        "ok": true,
        "version": {
          "major": 1,
          "minor": 5
        }
      }
    },
    {
      "name": "phone too old",
      "client": {
        "major": 1,
        "minor": 0
      },
      "supported": {
        "2": 0,
        "3": 1
      },
      "expect": {
        "ok": false,
        "code": "update_required",
        "supported": {
          "min": 2,
          "max": 3
        }
      }
    },
    {
      "name": "desktop too old",
      "client": {
        "major": 2,
        "minor": 0
      },
      "supported": {
        "1": 0
      },
      "expect": {
        "ok": false,
        "code": "desktop_update_required",
        "supported": {
          "min": 1,
          "max": 1
        }
      }
    },
    {
      "name": "1.1 phone, 1.0 desktop: no catalog",
      "client": {
        "major": 1,
        "minor": 1
      },
      "supported": {
        "1": 0
      },
      "expect": {
        "ok": true,
        "version": {
          "major": 1,
          "minor": 0
        }
      }
    },
    {
      "name": "1.0 phone, 1.1 desktop: no catalog",
      "client": {
        "major": 1,
        "minor": 0
      },
      "supported": {
        "1": 1
      },
      "expect": {
        "ok": true,
        "version": {
          "major": 1,
          "minor": 0
        }
      }
    },
    {
      "name": "1.1 both sides",
      "client": {
        "major": 1,
        "minor": 1
      },
      "supported": {
        "1": 1
      },
      "expect": {
        "ok": true,
        "version": {
          "major": 1,
          "minor": 1
        }
      }
    }
  ]
}
